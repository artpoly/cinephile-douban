": "https://img1.doubanio.com/view/photo/m_ratio_poster/public/p2932960618.jpg", "normal": "https://img1.doubanio.com/view/photo/s_ratio_poster/public/p2932960618.jpg"}, "rating": {"count": 0, "max": 10, "star_count": 0, "value": 0}, "tags": [], "title": "明明已经杀了丈夫", "type": "tv", "uri": "douban://douban.com/tv/38500285", "vendor_count": 0, "vendor_icons": [], "year": "2026"}, {"card_subtitle": "2026 / 日本 / 爱情 同性 / 进藤丈广 松尾大辅 / 小川史记 濑户利树", "comment": "社长之子、文武双全、校内站在金字塔顶端的五藤直也（小川饰），以及每天被他使唤来使唤去、身处底层阴角的高明（濑户饰）。即使面对直也不讲理的要求，高明也一直顺从。十年后，直也经营公司失败，失去了一切，处于无业状态。而高明则作为一家初创公司的年轻社长取得了成功，两人的社会地位完全逆转。即便如此，高明如今仍像“仆人”一样侍奉在直也身边。这是一种可悲又滑稽，略带扭曲却从未中断的关系。作品中描绘了两人在近乎执着的专一情感，以及自尊与自卑的夹缝中挣扎，同时关系逐渐发生变化的模样。\n故事讲述了曾经如“王子”般君临天下的男人，与一直服从于他的“仆人”，在社会地位逆转后，历经十年的主仆关系。", "episodes_info": "", "has_linewatch": false, "honor_infos": [], "id": "38489149", "interest": null, "photos": ["https://img2.doubanio.com/view/photo/m/public/p2933879801.jpg", "https://img9.doubanio.com/view/photo/m/public/p2933587246.jpg", "https://img9.doubanio.com/view/photo/m/public/p2934557014.jpg", "https://img3.doubanio.com/view/photo/m/public/p2934557013.jpg"], "pic": {"large": "https://img9.doubanio.com/view/photo/m_ratio_poster/public/p2934111104.jpg", "normal": "https://img9.doubanio.com/view/photo/s_ratio_poster/public/p2934111104.jpg"}, "rating": {"count": 189, "max": 10, "star_count": 3.0, "value": 5.6}, "tags": [], "title": "仆人的王子殿下", "type": "tv", "uri": "douban://douban.com/tv/38489149", "vendor_count": 0, "vendor_icons": [], "year": "2026"}]}